# QuietZone - Environment Variables Example
# Copy this file to .env and fill in your actual keys.
# DO NOT commit your .env file to version control.

# Supabase Configuration
# Required for database access, authentication, and file storage.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini API
# Required for AI acoustic analysis of the recorded audio samples.
# (Gemini 1.5 Flash is used for the audio-to-text classification)
GEMINI_API_KEY=your-google-gemini-api-key
